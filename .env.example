# Cargo Risk ML Lab – environment template
# Copy to .env and adjust. Never commit real secrets.

# Application
APP_ENV=development
LOG_LEVEL=INFO
RANDOM_SEED=42

# Paths (relative to project root unless absolute)
CONFIG_PATH=configs/default.yaml
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
ARTIFACTS_DIR=artifacts

# API
API_HOST=0.0.0.0
API_PORT=8000
API_MAX_BATCH_SIZE=100
API_MAX_REQUEST_BYTES=1048576
# Leave empty to disable POST /reload. Never bake a real token into images.
API_RELOAD_TOKEN=

# MLflow
MLFLOW_TRACKING_URI=sqlite:///mlruns/mlflow.db
MLFLOW_EXPERIMENT_NAME=cargo-risk-ml-lab
CHAMPION_PATH=artifacts/mlops/champion.json

# Streamlit
# Local default. Inside Docker Compose this is http://api:8000.
STREAMLIT_API_URL=http://127.0.0.1:8000
